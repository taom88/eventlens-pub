            "$ref": "#/$defs/CanonicalMetric"
          },
          "title": "Canonical Metrics",
          "type": "array"
        },
        "content_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "event_id": {
          "minLength": 1,
          "title": "Event Id",
          "type": "string"
        },
        "evidence": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ExternalEvidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "forbidden_behaviors": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Forbidden Behaviors",
          "type": "array"
        },
        "historical_context": {
          "default": [],
          "items": {
            "$ref": "#/$defs/HistoricalContextRef"
          },
          "title": "Historical Context",
          "type": "array"
        },
        "information_cutoff_at": {
          "format": "date-time",
          "title": "Information Cutoff At",
          "type": "string"
        },
        "instructions": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Instructions",
          "type": "array"
        },
        "missingness": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Missingness",
          "type": "array"
        },
        "research_question": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Research Question",
          "type": "string"
        },
        "route": {
          "$ref": "#/$defs/AgentRoute"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "session_id": {
          "minLength": 1,
          "title": "Session Id",
          "type": "string"
        },
        "target_release_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Release At"
        },
        "target_release_status": {
          "minLength": 1,
          "title": "Target Release Status",
          "type": "string"
        },
        "ticker": {
          "minLength": 1,
          "title": "Ticker",
          "type": "string"
        },
        "unavailable_stages": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Unavailable Stages",
          "type": "array"
        },
        "warnings": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "bundle_id",
        "session_id",
        "event_id",
        "ticker",
        "route",
        "bundle_revision",
        "built_at",
        "information_cutoff_at",
        "target_release_status",
        "research_question",
        "content_sha256"
      ],
      "title": "ExternalAgentBundle",
      "type": "object"
    },
    "ExternalAgentReport": {
      "additionalProperties": false,
      "properties": {
        "abstention": {
          "anyOf": [
            {
              "$ref": "#/$defs/Abstention"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "bundle_id": {
          "minLength": 1,
          "title": "Bundle Id",
          "type": "string"
        },
        "bundle_revision": {
          "minimum": 1,
          "title": "Bundle Revision",
          "type": "integer"
        },
        "bundle_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Bundle Sha256",
          "type": "string"
        },
        "claims": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ExternalClaim"
          },
          "title": "Claims",
          "type": "array"
        },
        "event_id": {
          "minLength": 1,
          "title": "Event Id",
          "type": "string"
        },
        "generated_at": {
          "format": "date-time",
          "title": "Generated At",
          "type": "string"
        },
        "reaction_forecast": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReactionForecast"
            },
            {
              "type": "null"
            }
          ],
          "default": null
