        "recommendation": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExternalRecommendation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "report_id": {
          "minLength": 1,
          "title": "Report Id",
          "type": "string"
        },
        "scenarios": {
          "items": {
            "$ref": "#/$defs/ExternalScenario"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Scenarios",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "session_id": {
          "minLength": 1,
          "title": "Session Id",
          "type": "string"
        },
        "usage": {
          "$ref": "#/$defs/UsageReceipt"
        },
        "valuation_zones": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ValuationZone"
          },
          "title": "Valuation Zones",
          "type": "array"
        },
        "warnings": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "report_id",
        "bundle_id",
        "bundle_revision",
        "bundle_sha256",
        "session_id",
        "event_id",
        "generated_at",
        "scenarios",
        "usage"
      ],
      "title": "ExternalAgentReport",
      "type": "object"
    },
    "ExternalClaim": {
      "additionalProperties": false,
      "properties": {
        "citations": {
          "items": {
            "$ref": "#/$defs/Citation"
          },
          "minItems": 1,
          "title": "Citations",
          "type": "array"
        },
        "claim_id": {
          "minLength": 1,
          "title": "Claim Id",
          "type": "string"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Confidence"
        },
        "kind": {
          "default": "interpretation",
          "enum": [
            "fact",
            "interpretation"
          ],
          "title": "Kind",
          "type": "string"
        },
        "text": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "claim_id",
        "text",
        "citations",
        "confidence"
      ],
      "title": "ExternalClaim",
      "type": "object"
    },
    "ExternalEvidence": {
      "additionalProperties": false,
      "properties": {
        "available_at": {
          "format": "date-time",
          "title": "Available At",
          "type": "string"
        },
        "content_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "evidence_kind": {
          "minLength": 1,
          "title": "Evidence Kind",
          "type": "string"
        },
        "passage_id": {
          "minLength": 1,
          "title": "Passage Id",
          "type": "string"
        },
        "provenance_ref": {
          "minLength": 1,
          "title": "Provenance Ref",
          "type": "string"
        },
        "retention_status": {
          "$ref": "#/$defs/EvidenceRetentionStatus"
