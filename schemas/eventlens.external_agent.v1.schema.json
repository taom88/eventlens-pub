{
  "$defs": {
    "Abstention": {
      "additionalProperties": false,
      "properties": {
        "missing_evidence_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Missing Evidence Ids",
          "type": "array"
        },
        "reason": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "reason"
      ],
      "title": "Abstention",
      "type": "object"
    },
    "AgentRoute": {
      "enum": [
        "external",
        "deepseek"
      ],
      "title": "AgentRoute",
      "type": "string"
    },
    "CanonicalMetric": {
      "additionalProperties": false,
      "properties": {
        "as_of": {
          "format": "date-time",
          "title": "As Of",
          "type": "string"
        },
        "calculation_version": {
          "minLength": 1,
          "title": "Calculation Version",
          "type": "string"
        },
        "metric_id": {
          "minLength": 1,
          "title": "Metric Id",
          "type": "string"
        },
        "missing_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Missing Reason"
        },
        "period": {
          "minLength": 1,
          "title": "Period",
          "type": "string"
        },
        "provenance_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Provenance Ids",
          "type": "array"
        },
        "scope": {
          "const": "pre_event",
          "default": "pre_event",
          "title": "Scope",
          "type": "string"
        },
        "unit": {
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "metric_id",
        "unit",
        "period",
        "as_of",
        "calculation_version"
      ],
      "title": "CanonicalMetric",
      "type": "object"
    },
    "Capability": {
      "additionalProperties": false,
      "properties": {
        "capability_id": {
          "minLength": 1,
          "title": "Capability Id",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "capability_id",
        "version"
      ],
      "title": "Capability",
      "type": "object"
    },
    "Citation": {
      "additionalProperties": false,
      "description": "A report claim's immutable reference to a supplied evidence passage.",
      "properties": {
        "passage_id": {
          "minLength": 1,
          "title": "Passage Id",
          "type": "string"
        },
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "passage_id"
      ],
      "title": "Citation",
      "type": "object"
    },
    "EvidenceRetentionStatus": {
      "enum": [
        "bounded_excerpt",
        "summary_only",
        "headline_only"
      ],
      "title": "EvidenceRetentionStatus",
      "type": "string"
    },
    "EvidenceRightsStatus": {
      "enum": [
        "retention_permitted",
        "summary_permitted",
        "metadata_only"
      ],
      "title": "EvidenceRightsStatus",
      "type": "string"
    },
    "ExternalAgentBundle": {
      "additionalProperties": false,
