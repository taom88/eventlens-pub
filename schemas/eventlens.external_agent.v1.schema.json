        "event_date",
        "knowledge_cutoff_at",
        "card_sha256",
        "readable_summary"
      ],
      "title": "HistoricalContextRef",
      "type": "object"
    },
    "ReactionForecast": {
      "additionalProperties": false,
      "properties": {
        "absolute_move_pct": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Absolute Move Pct"
        },
        "horizon": {
          "minLength": 1,
          "title": "Horizon",
          "type": "string"
        },
        "signed_move_pct": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Signed Move Pct"
        },
        "tradeability": {
          "minLength": 1,
          "title": "Tradeability",
          "type": "string"
        },
        "uncertainty": {
          "minLength": 1,
          "title": "Uncertainty",
          "type": "string"
