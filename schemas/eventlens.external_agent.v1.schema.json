        "source_id",
        "passage_id",
        "evidence_kind",
        "available_at",
        "content_sha256",
        "rights_status",
        "retention_status",
        "provenance_ref"
      ],
      "title": "ExternalEvidence",
      "type": "object"
    },
    "ExternalRecommendation": {
      "additionalProperties": false,
