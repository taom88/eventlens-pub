            "$ref": "#/$defs/Capability"
          },
          "title": "Allowed Tools",
          "type": "array"
        },
        "built_at": {
          "format": "date-time",
          "title": "Built At",
          "type": "string"
        },
        "bundle_id": {
          "minLength": 1,
          "title": "Bundle Id",
          "type": "string"
        },
        "bundle_revision": {
          "minimum": 1,
          "title": "Bundle Revision",
          "type": "integer"
        },
        "canonical_metrics": {
          "default": [],
