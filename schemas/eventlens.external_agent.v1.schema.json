            "type": "string"
          },
          "title": "Metric Refs",
          "type": "array"
        },
        "upper": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
