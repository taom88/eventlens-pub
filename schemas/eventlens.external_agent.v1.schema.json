        "counter_thesis": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Counter Thesis",
          "type": "string"
        },
        "invalidations": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Invalidations",
          "type": "array"
        },
        "missing_evidence": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Missing Evidence",
          "type": "array"
        },
        "supporting_evidence_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Supporting Evidence Ids",
          "type": "array"
        },
        "thesis": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Thesis",
          "type": "string"
        }
      },
      "required": [
        "action",
        "conviction",
        "thesis",
        "counter_thesis"
      ],
      "title": "ExternalRecommendation",
      "type": "object"
    },
    "ExternalScenario": {
      "additionalProperties": false,
      "properties": {
        "assumptions": {
          "default": [],
          "items": {
            "type": "string"
          },
