# EventLens credential and provider configuration
# Copy this file to .env. Never commit .env or paste real keys into source files.

# -----------------------------------------------------------------------------
# Durable research memory (required for deployments).
# -----------------------------------------------------------------------------
# Local storage is the zero-configuration demo/test default. Deployed instances
# use their own Supabase project; hosted credentials stay server-side.
EVENTLENS_MEMORY_BACKEND=local
EVENTLENS_MEMORY_SQLITE_PATH=.eventlens-cache/research-memory.sqlite
EVENTLENS_MEMORY_OWNER_ID=local-owner
EVENTLENS_MEMORY_WORKSPACE_ID=local-workspace
EVENTLENS_SUPABASE_URL=
EVENTLENS_SUPABASE_SECRET_KEY=
# CLI/deployment values. These are not used by the EventLens application.
SUPABASE_PROJECT_REF=
EVENTLENS_SUPABASE_REQUEST_TIMEOUT_SECONDS=30

# -----------------------------------------------------------------------------
# Confirmed free-tier market-data keys to obtain first
# -----------------------------------------------------------------------------
# Free key: https://www.alphavantage.co/support/#api-key
# Free tier is currently limited to 25 requests/day. EventLens defaults to an
# internal budget of 20/day and reserves this provider for transcripts and
# earnings context. Historical options and full adjusted history are premium.
ALPHAVANTAGE_API_KEY=
EVENTLENS_ALPHA_VANTAGE_DAILY_BUDGET=20

# Free account/key: https://finnhub.io/register
# EventLens caches every response and defaults to an internal budget of 50/day.
# Use primarily for earnings calendar/surprise cross-checks, not daily OHLCV.
FINNHUB_API_KEY=
EVENTLENS_FINNHUB_DAILY_BUDGET=50

# -----------------------------------------------------------------------------
# No-key sources used before spending keyed quota
# -----------------------------------------------------------------------------
# Required contact identity for compliant SEC EDGAR requests. Replace with a
# real monitored address; EventLens rejects example.com placeholders.
EVENTLENS_SEC_USER_AGENT=
# yfinance requires no key. Install with: pip install -e '.[free-data]'
EVENTLENS_ENABLE_YFINANCE=true
EVENTLENS_PROVIDER_CACHE_DIR=.eventlens-cache/providers
EVENTLENS_DATA_MODE=fixture
EVENTLENS_FIXTURE_DIR=fixtures

# Keep keyed market-data credentials out of Vibe-Trading's automatic fallback
# chain. EventLens's direct adapters meter them. Change only for a deliberate
# Vibe compatibility test.
EVENTLENS_ALLOW_VIBE_KEYED_MARKET_DATA=false
# Keep synthetic/curated option fixtures out of live canonical calculations
# unless an analyst has reviewed the file and explicitly accepts hybrid mode.
EVENTLENS_ALLOW_LIVE_FIXTURE_OPTIONS=false

# -----------------------------------------------------------------------------
# Vibe-Trading research engine
# -----------------------------------------------------------------------------
EVENTLENS_VIBE_ARTIFACT_DIR=.eventlens-cache/vibe-artifacts
# EventLens is an MCP client of the official Vibe server. Local stdio is the
# default and forwards no EventLens API keys into the child process.
EVENTLENS_VIBE_MCP_TRANSPORT=stdio
EVENTLENS_VIBE_MCP_CONNECTION_TIMEOUT_SECONDS=15
EVENTLENS_VIBE_MCP_TOOL_TIMEOUT_SECONDS=60
EVENTLENS_VIBE_MCP_MAX_ATTEMPTS=2
# For a separately running official server (0.1.12+ documented surface):
# EVENTLENS_VIBE_MCP_TRANSPORT=streamable_http
# EVENTLENS_VIBE_MCP_HTTP_URL=http://127.0.0.1:8900/mcp
# Required for non-loopback HTTP deployments; this authenticates the MCP
# transport only and is not an LLM, market-data, or broker credential.
# EVENTLENS_VIBE_MCP_HTTP_AUTH_KEY=
# Broad CLI/agent/swarm research remains disabled unless explicitly enabled
# after the analyst hypothesis is locked.
EVENTLENS_ENABLE_POSTLOCK_VIBE_BROAD_RESEARCH=false
# External-agent mode exports a typed bundle and pauses for validated import;
# it never invokes an external agent automatically. Set false to use DeepSeek.
EVENTLENS_EXTERNAL_AGENT_ENABLED=true

# Choose exactly one Vibe-Trading LLM provider block.
# Recommended starting choice for this project: DeepSeek official API.
# Vibe's own LLM configuration is used only by its broad agent/CLI/swarm
# surfaces; the six pre-lock MCP evidence tools do not receive EventLens's
# external reasoning key automatically.
LANGCHAIN_PROVIDER=deepseek
LANGCHAIN_MODEL_NAME=deepseek-v4-pro
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Direct typed synthesis agent used only when the external-agent route is
# explicitly disabled. Set provider to fixture for a no-network replay.
EVENTLENS_AGENT_PROVIDER=deepseek
EVENTLENS_AGENT_MODEL=deepseek-v4-pro
EVENTLENS_AGENT_TIMEOUT_SECONDS=60
EVENTLENS_AGENT_MAX_ATTEMPTS=3
EVENTLENS_AGENT_MAX_TOKENS=4000
EVENTLENS_WORKFLOW_ARTIFACT_DIR=.eventlens-cache/workflows

# Alternative: Moonshot/Kimi open platform. Comment out the DeepSeek block
# before enabling this block.
# LANGCHAIN_PROVIDER=moonshot
# LANGCHAIN_MODEL_NAME=kimi-k2.6
# MOONSHOT_API_KEY=
# MOONSHOT_BASE_URL=https://api.moonshot.ai/v1
# EVENTLENS_AGENT_PROVIDER=moonshot
# EVENTLENS_AGENT_MODEL=kimi-k2.6

# Alternative with no API bill: local Ollama (hardware permitting).
# LANGCHAIN_PROVIDER=ollama
# LANGCHAIN_MODEL_NAME=qwen2.5:32b
# OLLAMA_BASE_URL=http://localhost:11434

# -----------------------------------------------------------------------------
# Optional Massive news provider; configure only when the run manifest selects it.
# -----------------------------------------------------------------------------
MASSIVE_API_KEY=

# Optional future paid providers. Do not obtain these for the MVP yet.
FMP_API_KEY=
TIINGO_API_KEY=
INTRINIO_API_KEY=
FRED_API_KEY=
